PORT=3000
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Yönetici yetkisi kayıt sırasında e-posta adresinden verilmez. README'deki yerel komutu kullan.
# Production registration requires an email provider. Railway Free/Trial requires HTTPS email API (Brevo), not SMTP.
BREVO_API_KEY=
BREVO_FROM=
# SMTP is an alternative only when the host allows outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Google Identity Services: public OAuth client ID, not a client secret.
GOOGLE_CLIENT_ID=
# Android Trusted Web Activity: Play Console'daki App signing key ve yerel test için upload key SHA-256.
PLAY_APP_SIGNING_SHA256=
ANDROID_UPLOAD_SHA256=
# Legal drafts are hidden until reviewed and explicitly enabled.
LEGAL_ENABLED=0
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=unisatis06@gmail.com
LEGAL_CONTACT_ADDRESS=
# Server only: never put this key in public files or Android resources.
OPENAI_API_KEY=
APP_ASSISTANT_MODEL=gpt-4.1-mini
APP_ASSISTANT_DAILY_LIMIT=200
# Use gemini for the assistant when using a Gemini Free tier project.
# Billing must remain disabled on that Google project to avoid API charges.
# No fallback to OpenAI when Gemini is selected or its free quota is exhausted.
APP_ASSISTANT_PROVIDER=
GEMINI_API_KEY=
GEMINI_ASSISTANT_MODEL=gemini-3.6-flash
# Enable only after adding a valid key. When enabled, failures block new photos.
PHOTO_MODERATION_ENABLED=0
# Netgsm OTP SMS: server only. Supplying valid credentials enables phone gates.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
SMS_DAILY_LIMIT=100
# Set 1 after SMS service activation; all trading requires verified email and phone.
REQUIRE_CONTACT_VERIFICATION=0
# Production automatically backs up every 6 hours. 0 disables, 1 explicitly enables.
BACKUP_ENABLED=
# Prefer an independently backed-up persistent volume; empty uses DATA_DIR/backups.
BACKUP_DIR=
